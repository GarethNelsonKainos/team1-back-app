PORT=3001
DATABASE_URL="postgresql://<user>:<password>@localhost:5432/kainos-jobs?schema=public"

# JWT Configuration
# JWT_SECRET is REQUIRED - Generate a strong random secret: openssl rand -base64 32
JWT_SECRET="your-secret-key-here-use-openssl-rand-base64-32"
# JWT_EXPIRES_IN is optional (defaults to 24h)
JWT_EXPIRES_IN="24h"

# Bcrypt Configuration (REQUIRED)
# Recommended: 12 (good balance of security and performance)
BCRYPT_SALT_ROUNDS=12

# Frontend URL for CORS
FRONTEND_URL="http://localhost:3000"